# Rust build output
/target
**/*.rs.bk

# ECMA-376 reference material — kept LOCAL ONLY (used for schema codegen + spec lookup),
# never committed. Regenerating `mjx-ooxml-types` requires these present locally.
/References/

# Editor / OS cruft
.DS_Store
*.swp
.idea/
.vscode/

# Fuzzing artifacts
/fuzz/target
/fuzz/corpus
/fuzz/artifacts

# Binding build artefacts. The sources are committed; the products are not.
/bindings/*/target
/bindings/mjx-python/dist
# `maturin develop` drops the editable extension module beside the stub.
/bindings/mjx-python/python/mjx_ooxml/*.so
/bindings/mjx-python/python/mjx_ooxml/*.pyd
/bindings/mjx-python/.venv
/bindings/mjx-wasm/pkg
/bindings/mjx-wasm/pkg-*
/bindings/mjx-wasm/npm/dist
/bindings/mjx-wasm/npm/README.md
**/node_modules
**/__pycache__
*.egg-info
*.whl

# The local agent directory: session state, scheduled-task locks and the per-session git worktrees
# other Claude Code sessions check this repository out into. Nothing here is tracked, and since
# MJXOFF-290 the derived gates sweep the *working tree* rather than the Git index — so a directory
# that is not part of this repository has to say so where every tool already reads it.
/.claude/
