{
  "name": "@mjx/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The mjx-ooxml-rs client-platform component catalogue: framework-free custom elements, the TypeScript half of the token resolver, and the harness they are audited in.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "tokens:check": "node scripts/check-tokens.mjs",
    "icons:subset": "node scripts/subset-icons.mjs",
    "icons:check": "node scripts/subset-icons.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "build-storybook": "storybook build",
    "storybook": "storybook dev -p 6006 --no-open",
    "test:browser": "playwright test",
    "check": "npm run tokens:check && npm run icons:check && npm run typecheck && npm run lint && npm run test:unit && npm run build-storybook && npm run test:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fluentui/svg-icons": "^1.1.339",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.0",
    "@types/node": "^26.5.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "lit": "^3.3.3",
    "storybook": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
